!- DIN EN 15026 Benchmark Material

Material,
  EN15026_Material,  !- Name
  MediumSmooth,      !- Roughness
  1.0,               !- Thickness {m} - Thick enough for semi-infinite
  1.5,               !- Conductivity {W/m-K} (dry value)
  1.824e6,           !- Density {kg/m3} (this is actually rho*cp)
  1000.0,            !- Specific Heat {J/kg-K} (dummy, rho*cp is given)
  0.5,               !- Thermal Absorptance
  0.5,               !- Solar Absorptance
  0.5;               !- Visible Absorptance

